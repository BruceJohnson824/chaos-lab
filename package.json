{
  "name": "chaos-lab",
  "private": true,
  "version": "0.1.0",
  "description": "CHAOS.EXE is an interactive element sandbox for a university Halloween hackathon.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n core,lab -c magenta,cyan \"tsx server/index.ts\" \"vite\"",
    "start": "tsx server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json --noEmit && vite build",
    "lint": "oxlint",
    "test": "tsx server/validate.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@google/genai": "^2.30.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^9.2.5",
    "oxlint": "^1.81.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
